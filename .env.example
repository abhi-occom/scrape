GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-rotated-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_SHEET_ID=fjsuifhdsfhsufihsfisufhsfushfsishfsifhsi
GOOGLE_SHEET_TAB=Sheet1
FLASK_SECRET_KEY=replace-with-a-long-random-local-secret

# --- ISP Scraper Agent (see AI_AGENT_BROWSER_PLAN.md) ---
# Which translator backend /agent uses: claude, gemini, or rule_based (default).
# Falls back to rule_based automatically if the chosen provider's key/SDK is missing.
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
ANTHROPIC_TRANSLATOR_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_TRANSLATOR_MODEL=gemini-2.5-flash

# Phase 4 (optional): local LLM fallback extractor via Ollama. Off by default.
AGENT_ENABLE_LOCAL_LLM_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M